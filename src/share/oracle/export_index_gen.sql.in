SET LONG 600000
SET PAGESIZE 0
SET LINESIZE 300
SET LONGC 300
SET TRIMSPOOL ON
SET TERM OFF
SET FEEDBACK OFF
set SERVEROUTPUT on

spool IDX_DIRexport_index_IDX_NAME.sql
select 'SET LONG 600000' from dual;
select 'SET PAGESIZE 0' from dual;
select 'SET LINESIZE 300' from dual;
select 'SET LONGC 300' from dual;
select 'SET TRIMSPOOL ON' from dual; 
select 'SET TERM OFF' from dual;
select 'SET FEEDBACK OFF' from dual;
select 'set SERVEROUTPUT on' from dual;
DECLARE
   res VARCHAR2(800);
   indexsdir VARCHAR2(500) := 'IDX_DIR';
   indexname VARCHAR2(500) := 'IDX_NAME';
   filter_no_constraint NUMBER := FILTERNOCONST;
BEGIN
    FOR t_name IN (

        select UI.index_name
        from user_indexes UI LEFT JOIN USER_CONSTRAINTS UC
            ON UC.INDEX_NAME = UI.INDEX_NAME
        where 1=1
        AND UI.INDEX_NAME = UPPER(indexname)
        AND (filter_no_constraint = 0 OR UC.CONSTRAINT_NAME IS NULL)
        ORDER BY UI.INDEX_NAME

    ) LOOP
      SELECT CASE WHEN SUBSTR(LOWER(t_name.INDEX_NAME),1 , 3) = 'idx'
                  THEN 'spool '||indexsdir||'idx'||InitCap(REPLACE(LOWER(t_name.INDEX_NAME), 'idx', ''))||'.sql'
                  ELSE 'spool '||indexsdir||LOWER(t_name.INDEX_NAME)||'.sql'
             END into res
      FROM dual;   
      dbms_output.put_line (res); 
      dbms_output.put_line ('BEGIN'); 
      select 'DBMS_METADATA.SET_TRANSFORM_PARAM(DBMS_METADATA.SESSION_TRANSFORM,''STORAGE'',false);' into res from dual;
      dbms_output.put_line (res); 
      select 'DBMS_METADATA.SET_TRANSFORM_PARAM(DBMS_METADATA.SESSION_TRANSFORM,''SQLTERMINATOR'',true);' into res from dual;
      dbms_output.put_line (res); 
      select 'DBMS_METADATA.SET_TRANSFORM_PARAM(DBMS_METADATA.SESSION_TRANSFORM,''SEGMENT_ATTRIBUTES'',true);' into res from dual;
      dbms_output.put_line (res); 
      dbms_output.put_line ('END;'); 
      dbms_output.put_line ('/'); 

      select  'select REGEXP_REPLACE('||
                'REPLACE(REPLACE('||
                'REGEXP_REPLACE('||
                    'REGEXP_REPLACE(IDX, ''(''||CHR(10)||''\s*PCTFREE.*''||CHR(10)||'')'','''')'||
                ', ''(''||CHR(10)||''\s*STORAGE.*''||CHR(10)||'')'','''')'||
                ', '' "''||OWNER||''"."'', '' "''), ''EDITIONABLE '', '''')'||
                ', ''TABLESPACE ".*"'', ''TABLESPACE "<TBL_IDX>"'') AS IX '||
                'from '||
                '('||
                '    select  TRIM(dbms_metadata.GET_DDL(''INDEX'',UI.INDEX_NAME)) AS IDX, '||
                '    (select username from user_users) AS OWNER '||
                '    from USER_INDEXES UI LEFT JOIN USER_CONSTRAINTS UC '||
                '        ON UC.INDEX_NAME = UI.INDEX_NAME '||
                '    where 1=1 '||
                '    AND UI.INDEX_NAME = UPPER('''||t_name.index_name||''') '||
                CASE WHEN filter_no_constraint = 0 THEN '' ELSE
                '    AND UC.CONSTRAINT_NAME IS NULL '
                END||
                '    ORDER BY UI.INDEX_NAME '||
                ') TMP_IX;' into res from dual;
      dbms_output.put_line (res); 
      select 'spool off;' into res from dual;
      dbms_output.put_line (res); 
      select ' ' into res from dual;
      dbms_output.put_line (res); 
   END LOOP;
END;
/
select 'exit' from dual;
spool off;
exit
/

